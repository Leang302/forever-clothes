# Copy to deploy/.env (git-ignored) and fill in. Never commit the filled-in file.

# Public hostnames (DNS A records -> this server). The admin is at https://SITE_DOMAIN/admin
SITE_DOMAIN=shop.example.com
API_DOMAIN=api.shop.example.com

# Secrets — generate fresh values:  openssl rand -base64 48  /  openssl rand -hex 24
DB_PASSWORD=
JWT_SECRET=
MINIO_ACCESS_KEY=forever
MINIO_SECRET_KEY=

# Seeded admin account (created on first start). Do NOT reuse the dev default password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMTP for OTP / order e-mails (e.g. a transactional mail provider)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@shop.example.com

# Bakong KHQR (https://api-bakong.nbc.gov.kh/register). Required for the KHQR payment demo: if left empty the
# API answers KHQR_NOT_CONFIGURED and the KHQR option at checkout shows that error (COD still works).
# Never point production at dev/fake-bakong.mjs.
KHQR_ACCOUNT_ID=
KHQR_MERCHANT_NAME=Forever
KHQR_MERCHANT_CITY=Phnom Penh
KHQR_API_TOKEN=
